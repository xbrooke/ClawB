{
  "name": "clawb",
  "version": "2.0.0",
  "description": "ClawB Desktop - 面向 OpenClaw 的跨平台桌面控制台",
  "main": "dist-electron/main.js",
  "author": "ClawB Team",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build && electron-builder",
    "dev:electron": "vite build && electron .",
    "preview": "vite preview"
  },
  "dependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "~5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "ai.clawb.desktop",
    "productName": "ClawB",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    }
  }
}